# Base de datos (SQLite por defecto; cualquier URL SQLAlchemy funciona)
NASA_DATABASE_URL=sqlite:///D:/NASA/backend/data/nasa_space.db

# Idioma por defecto del backend (es | en)
NASA_DEFAULT_LANG=es

# Cache de evaluaciones en memoria (segundos). Se invalida por eventos.
NASA_CACHE_TTL_SECONDS=30

# Umbrales de triage (%/mes de perdida de BUA)
NASA_LEVEL_RISK_RATE=0.8
NASA_LEVEL_ALERT_RATE=1.5
NASA_LEVEL_ALERT_CUMULATIVE=3.0

# Clasificacion por referencia poblacional (T-score, convencion OMS)
NASA_BONE_T_OSTEOPENIA=-1.0
NASA_BONE_T_OSTEOPOROSIS=-2.5
